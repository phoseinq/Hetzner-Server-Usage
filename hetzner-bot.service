[Unit]
Description=Hetzner Server Usage Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# DATA_FILE / overage_history.json are relative paths, so the bot must
# run from the repo directory. install.sh replaces __DIR__ automatically.
WorkingDirectory=__DIR__
ExecStart=__DIR__/venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
